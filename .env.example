# Copy this file to .env.local and fill in real values.
# `npx convex dev` will create/update the Convex-related values below automatically
# the first time you run it (it writes straight to .env.local).

# Convex deployment URL, e.g. https://happy-animal-123.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# Deployment name used by the Convex CLI, e.g. dev:happy-animal-123
CONVEX_DEPLOYMENT=
